# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=
OPENAI_API_KEY=
APP_URL=https://styni.com
PORT=3000
NODE_ENV=development

# PAYNOW ZIMBABWE PAYMENT GATEWAY INTEGRATION
# Obtain live credentials from your Paynow Zimbabwe merchant dashboard: https://www.paynow.co.zw
# In production, these are strictly required. Never expose these keys in frontend bundles or logs.
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PAYNOW_RESULT_URL=https://styni.com/api/payments/paynow/webhook
PAYNOW_RETURN_URL=https://styni.com/wallet
